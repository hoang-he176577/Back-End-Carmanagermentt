###
# Ghi chú:
# - Lấy 'id' trả về từ response này (vehicle vừa tạo) và cập nhật lại biến
#   @vehicleId ở đầu file (KHÔNG dùng vehicle id 1,2 đã seed vì đang Active + Assigned)
#   để dùng cho các test assign/unassign bên dưới.
###

###
# 2. Asset Management (Create) - duplicate (expect 409)
###
POST {{host}}/api/assets/vehicles/asset-create
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "licensePlate": "51A-123.45",
  "modelId": 1,
  "yearManufacture": 2022,
  "purchaseDate": "2024-01-10",
  "originalCost": 800000000,
  "currentValue": 780000000,
  "mileage": 1000,
  "status": null,
  "currentBranchId": 1,
  "currentDriverId": null,
  "vin": "VIN-TEST-0001",
  "engineNumber": "ENG-0001",
  "chassisNumber": "CHS-0001"
}

###
# Kết quả mong đợi:
# - HTTP 409
# - Message: LicensePlate already exists. hoặc Vin/EngineNumber/ChassisNumber already exists.
###

###
# 3. Asset Management (Create) - missing VIN (expect 400)
###
POST {{host}}/api/assets/vehicles/asset-create
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "licensePlate": "51A-999.99",
  "modelId": 1,
  "vin": "",
  "engineNumber": "ENG-0002",
  "chassisNumber": "CHS-0002"
}

###
# Kết quả mong đợi:
# - HTTP 400
# - Message: Vin is required.
###

###
# 4. Asset Management (Create) - invalid registration/insurance dates (expect 400)
###
POST {{host}}/api/assets/vehicles/asset-create
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "licensePlate": "51A-234.56",
  "modelId": 1,
  "vin": "VIN-TEST-0002",
  "engineNumber": "ENG-0002",
  "chassisNumber": "CHS-0002",
  "registrationIssueDate": "2024-02-01",
  "registrationExpiryDate": "2024-01-01"
}

###
# Kết quả mong đợi:
# - HTTP 400
# - Message: RegistrationExpiryDate must be >= RegistrationIssueDate.
###

###
# 5. Vehicle Assignment - assign success
# Yêu cầu:
# - Đã update @vehicleId bằng id của vehicle Available
# - @driverId trỏ tới driver hợp lệ trong DB
###
POST {{host}}/api/assets/vehicles/{{vehicleId}}/assign
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "driverId": {{driverId}},
  "assignDate": "2024-03-01",
  "notes": "Assign for project A"
}

###
# Kết quả mong đợi:
# - HTTP 200
# - status = "Assigned", currentDriverId = driverId
###

###
# 6. Vehicle Assignment - assign when not Available (expect 409)
###
POST {{host}}/api/assets/vehicles/{{vehicleId}}/assign
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "driverId": {{driverId}},
  "assignDate": "2024-03-02",
  "notes": "Should fail, already assigned"
}

###
# Kết quả mong đợi:
# - HTTP 409
# - Message: Vehicle is not available for assignment.
###

###
# 7. Vehicle Assignment - driver not found (expect 400)
###
POST {{host}}/api/assets/vehicles/{{vehicleId}}/assign
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "driverId": 999999,
  "assignDate": "2024-03-03",
  "notes": "Non-existent driver"
}

###
# Kết quả mong đợi:
# - HTTP 400
# - Message: Driver not found.
###

###
# 8. Vehicle Assignment - unassign success
###
POST {{host}}/api/assets/vehicles/{{vehicleId}}/unassign
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "vehicleId": {{vehicleId}},
  "unassignDate": "2024-03-10",
  "notes": "Finish project A"
}

###
# Kết quả mong đợi:
# - HTTP 200
# - status = "Available", currentDriverId = null
###

###
# 9. Vehicle Assignment - unassign when already Available (expect 400)
###
POST {{host}}/api/assets/vehicles/{{vehicleId}}/unassign
Authorization: Bearer {{accountantToken}}
Content-Type: application/json

{
  "vehicleId": {{vehicleId}}
}

###
# Kết quả mong đợi:
# - HTTP 400
# - Message: Vehicle is not currently assigned.
###

